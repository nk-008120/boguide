# BiOGuide environment variables
# Copy this file to .env (local dev) or set these in Vercel's Project Settings.
# .env is gitignored -- never commit real values.

# --- Build-time (read by Hugo, injected into the browser via layouts/partials/custom/head-end.html) ---
# Same Supabase project as the runtime vars below, just re-exposed with the HUGO_ prefix
# so `hugo server`/`hugo build` can read them via getenv.
HUGO_SUPABASE_URL=https://your-project.supabase.co
HUGO_SUPABASE_ANON_KEY=your-anon-key

# --- Runtime (read by Vercel serverless functions in api/, via api/_lib/supabaseAdmin.js) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Build-time (read by Hugo; product analytics, layouts/partials/scripts/posthog.html) ---
# HUGO_POSTHOG_KEY is a public Project API Key, safe to expose client-side, but leave this
# as a placeholder here anyway so the template stays generic. Omit both to disable PostHog
# entirely (it no-ops with no error if HUGO_POSTHOG_KEY is unset).
HUGO_POSTHOG_KEY=your-posthog-project-api-key
HUGO_POSTHOG_HOST=https://eu.i.posthog.com

# --- Build-time (read by Hugo; Google Analytics 4, layouts/partials/scripts/ga4.html) ---
# The GA4 Measurement ID is not secret (it's always visible in the page source), but the
# same placeholder convention applies. Omit to disable GA4 entirely.
HUGO_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Runtime (read by api/_lib/cronAuth.js) ---
# One shared secret that authorises /api/daily-cron (sent by Vercel Cron), the GitHub Action in
# .github/workflows/bioclash-cleanup.yml (set the same value as a repository secret there), and
# the grading and finalisation actions of /api/bioclash-admin. Use a long random string.
CRON_SECRET=your-long-random-string

# --- Runtime (read by api/_lib/paperVault.js) ---
# Keys that decrypt data/bioclash/<paper>.yaml.enc. A comma separated list of <id>:<base64 key>;
# the first entry encrypts, every entry can decrypt. Generate one with
# `node scripts/bioclash-paper-vault.js keygen`. Keep a copy in a password manager: losing every
# copy makes an encrypted paper unrecoverable. Not needed if no encrypted paper is deployed.
BIOCLASH_PAPER_KEYS=k1:your-base64-32-byte-key

# --- Runtime (read by api/daily-cron.js; fills the visitor-country counter) ---
# A login for the self-hosted Umami instance. Omit all four and the daily job reports the country
# sync as failed, but the rest of the site is unaffected.
UMAMI_BASE_URL=https://your-umami-host
UMAMI_WEBSITE_ID=your-umami-website-id
UMAMI_USERNAME=your-umami-username
UMAMI_PASSWORD=your-umami-password

# --- Supabase Edge Function secret (set with `supabase secrets set`, not in Vercel) ---
# Read by supabase/functions/biolab-calibrate-delta as the allowed CORS origin. Optional: it falls
# back to https://bioguide.world. SUPABASE_URL and SUPABASE_ANON_KEY are provided to edge
# functions by Supabase itself.
SITE_ORIGIN=https://your-site.example

# --- Local tooling only (read by scripts/build-critical-css.mjs; never set in Vercel) ---
# All three are optional. PAGES is a comma separated list of paths.
# BASE_URL=http://localhost:1399
# CHROME_PATH=/path/to/chrome
# PAGES=/papers/ibo/2024/theoretical-a/q1/

# --- Runtime (read by Vercel serverless functions in api/, via api/_lib/sentry.js) ---
# Error tracking for the API layer only (not the Hugo frontend). Omit to disable entirely;
# every function falls back to console.error with no failed requests either way.
SENTRY_DSN=your-sentry-dsn
