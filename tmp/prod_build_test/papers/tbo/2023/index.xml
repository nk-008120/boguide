&lt;script&gt;
(function () {
var input = document.getElementById('papers-problem-filter');
var topicSelect = document.getElementById('papers-topic-filter');
var diffWrap = document.getElementById('papers-difficulty-filter');
var rows = document.querySelectorAll('#papers-problem-table .papers-problem-row');
var activeDifficulty = '';
function applyFilters() {
var q = input ? input.value.toLowerCase() : '';
var topic = topicSelect ? topicSelect.value : '';
rows.forEach(function (row) {
var matchesText = !q || row.textContent.toLowerCase().indexOf(q) !== -1;
var subjects = (row.dataset.subjects || '').split('||');
var matchesTopic = !topic || subjects.indexOf(topic) !== -1;
var matchesDifficulty = !activeDifficulty || row.dataset.difficulty === activeDifficulty;
row.style.display = (matchesText &amp;&amp; matchesTopic &amp;&amp; matchesDifficulty) ? '' : 'none';
});
}
if (input) input.addEventListener('input', applyFilters);
if (topicSelect) topicSelect.addEventListener('change', applyFilters);
if (diffWrap) {
diffWrap.addEventListener('click', function (e) {
var btn = e.target.closest('.papers-diff-btn');
if (!btn) return;
diffWrap.querySelectorAll('.papers-diff-btn').forEach(function (b) { b.classList.remove('is-active'); });
btn.classList.add('is-active');
activeDifficulty = btn.dataset.difficulty;
applyFilters();
});
}
})();
