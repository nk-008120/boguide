{
  "redirects": [
    {
      "source": "/bionuggets",
      "destination": "https://bionuggets2009.vercel.app/bionuggets",
      "statusCode": 302
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|gif|svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/js/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)_hu_(.*)\\.(webp|jpg|jpeg|png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/css/compiled/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "functions": {
    "api/submit-attempt.js": {
      "includeFiles": "data/papers/**"
    },
    "api/bioclash-cleanup.js": {
      "includeFiles": "data/bioclash/**"
    },
    "api/bioclash-start-attempt.js": {
      "includeFiles": "data/bioclash/**"
    },
    "api/bioclash-attempt-state.js": {
      "includeFiles": "data/bioclash/**"
    },
    "api/bioclash-submit-attempt.js": {
      "includeFiles": "data/bioclash/**"
    },
    "api/bioclash-save-draft.js": {
      "includeFiles": "data/bioclash/**"
    },
    "api/bioclash-lock-block.js": {
      "includeFiles": "data/bioclash/**"
    },
    "api/bioclash-request-extension.js": {
      "includeFiles": "data/bioclash/**"
    },
    "api/bioclash-export-grades.js": {
      "includeFiles": "data/bioclash/**"
    },
    "api/bioclash-finalize-round.js": {
      "includeFiles": "data/bioclash/**"
    }
  },
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/sync-country-stats",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/bioclash-cleanup",
      "schedule": "*/15 * * * *"
    }
  ]
}