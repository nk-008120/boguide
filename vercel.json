{
  "redirects": [
    {
      "source": "/papers/tbo",
      "destination": "/papers/",
      "statusCode": 302
    },
    {
      "source": "/papers/tbo/:path*",
      "destination": "/papers/",
      "statusCode": 302
    },
    {
      "source": "/bionuggets",
      "destination": "https://bionuggets2009.vercel.app/bionuggets",
      "statusCode": 302
    },
    {
      "source": "/biobytes/frontiers",
      "destination": "/biobytes/horizon",
      "statusCode": 301
    },
    {
      "source": "/biobytes/frontiers/",
      "destination": "/biobytes/horizon/",
      "statusCode": 301
    },
    {
      "source": "/biobytes/frontiers/astrobiology",
      "destination": "/biobytes/horizon/astrobiology",
      "statusCode": 301
    },
    {
      "source": "/biobytes/frontiers/astrobiology/",
      "destination": "/biobytes/horizon/astrobiology/",
      "statusCode": 301
    },
    {
      "source": "/biobytes/frontiers/drug-delivery",
      "destination": "/biobytes/horizon/drug-delivery",
      "statusCode": 301
    },
    {
      "source": "/biobytes/frontiers/drug-delivery/",
      "destination": "/biobytes/horizon/drug-delivery/",
      "statusCode": 301
    },
    {
      "source": "/biobytes/frontiers/:path*",
      "destination": "/biobytes/horizon/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'self'" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.plot.ly https://cdn.jsdelivr.net https://unpkg.com https://www.googletagmanager.com https://eu-assets.i.posthog.com https://bioguide-umami-five.vercel.app https://giscus.app; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://eu.i.posthog.com https://eu-assets.i.posthog.com https://*.google-analytics.com https://www.googletagmanager.com https://bioguide-umami-five.vercel.app https://cdn.jsdelivr.net; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://giscus.app https://docs.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'" }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|gif|svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/js/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)_hu_(.*)\\.(webp|jpg|jpeg|png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/css/compiled/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/bundles/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=31536000" }
      ]
    },
    {
      "source": "/data/globe-110m.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=31536000" }
      ]
    }
  ],
  "functions": {
    "api/submit-attempt.js": {
      "includeFiles": "data/papers/**"
    },
    "api/bioclash-admin.js": {
      "includeFiles": "data/bioclash/**"
    },
    "api/bioclash-start-attempt.js": {
      "includeFiles": "data/bioclash/**"
    },
    "api/bioclash-attempt-state.js": {
      "includeFiles": "data/bioclash/**"
    },
    "api/bioclash-submit-attempt.js": {
      "includeFiles": "data/bioclash/**"
    },
    "api/bioclash-save-draft.js": {
      "includeFiles": "data/bioclash/**"
    },
    "api/bioclash-lock-block.js": {
      "includeFiles": "data/bioclash/**"
    },
    "api/bioclash-request-extension.js": {
      "includeFiles": "data/bioclash/**"
    }
  },
  "crons": [
    {
      "path": "/api/daily-cron",
      "schedule": "0 5 * * *"
    }
  ]
}